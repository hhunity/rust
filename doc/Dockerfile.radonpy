# RadonPy用の実行環境イメージ。
#
# Ubuntu 22.04(jammy)をベースにするので、glibcバージョンはビルド時点で
# ターゲット(実機のjammy)と一致する。Windows上でconda環境を直接組み立てる
# 場合に問題になった「glibc版数合わせ」「展開時のシンボリックリンク/権限
# 崩れ」は、Dockerのイメージ形式(save/load)自体が正しく扱うため発生しない。
#
# ビルド(Mac/Apple Siliconの場合は必ず --platform を明示すること。
# 指定しないとMacのCPUアーキテクチャ(arm64)向けにビルドされてしまい、
# x86_64のUbuntu実機で動かなくなる):
#
#   docker build --platform linux/amd64 -f doc/Dockerfile.radonpy -t radonpy:latest .
#
# 動作確認:
#
#   docker run --rm --platform linux/amd64 radonpy:latest \
#     conda run -n radonpy python -c "import rdkit, radonpy; print('ok')"
#
# 保存してオフライン機へ転送する場合(レジストリを使わない方法):
#
#   docker save radonpy:latest | gzip > radonpy-image.tar.gz
#   # USB等で転送後、オフライン機側で:
#   docker load < radonpy-image.tar.gz
#
# レジストリ(Docker Hub等)にpushして使う場合:
#
#   docker tag radonpy:latest <dockerhubユーザー名>/radonpy:latest
#   docker push <dockerhubユーザー名>/radonpy:latest
#   # オフライン機側がレジストリに到達できるなら:
#   docker pull <dockerhubユーザー名>/radonpy:latest

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates bzip2 \
    && rm -rf /var/lib/apt/lists/*

# Miniconda導入
RUN curl -fsSL -o /tmp/miniconda.sh \
    https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
    && bash /tmp/miniconda.sh -b -p /opt/miniconda3 \
    && rm /tmp/miniconda.sh

ENV PATH=/opt/miniconda3/bin:$PATH

# defaults(pkgs/main, pkgs/r)はAnaconda社のToS同意が必要になったため使わず、
# conda-forgeのみを使う。
RUN conda config --set always_yes true \
    && conda config --remove channels defaults || true \
    && conda config --add channels conda-forge \
    && conda config --set channel_priority strict

RUN conda create -n radonpy python=3.11 --override-channels -c conda-forge -y

# RadonPyが要求する外部ツール・依存パッケージ一式(doc/radonpy-files.md参照)
RUN conda install -n radonpy --override-channels -c conda-forge -c psi4 \
    rdkit psi4 dftd3-python resp mdtraj psutil scipy pandas matplotlib pip lammps -y \
    && conda clean -afy

# RadonPy本体
RUN conda run -n radonpy pip install --no-cache-dir radonpy-pypi

# ビルド時点で最低限の動作確認をしておく(壊れていればここでビルド自体が失敗する)
RUN conda run -n radonpy python -c "import rdkit, radonpy; print('rdkit', rdkit.__version__)" \
    && conda run -n radonpy psi4 --version \
    && conda run -n radonpy lmp -h > /dev/null

# コンテナに入った時点でradonpy環境がデフォルトになるようにしておく
ENV PATH=/opt/miniconda3/envs/radonpy/bin:$PATH

WORKDIR /work
CMD ["/bin/bash"]
