# RadonPy用の実行環境イメージ。
#
# Ubuntu 22.04(jammy)をベースにするので、glibcバージョンはビルド時点で
# ターゲット(実機のjammy)と一致する。Windows上でconda環境を直接組み立てる
# 場合に問題になった「glibc版数合わせ」「展開時のシンボリックリンク/権限
# 崩れ」は、Dockerのイメージ形式(save/load)自体が正しく扱うため発生しない。
#
# condaディストリビューションは Miniconda(Anaconda社製)ではなく
# **Miniforge**(conda-forgeプロジェクト製)を使う。Minicondaはデフォルトで
# Anaconda社の`defaults`チャンネル(pkgs/main, pkgs/r)を前提にしており、
# これは利用規約上、一定規模以上の商用利用で有料ライセンスが必要になった。
# Miniforgeは最初からconda-forgeのみを使う構成なので、この問題が
# そもそも発生しない。
#
# ビルド(Mac/Apple Siliconの場合は必ず --platform を明示すること。
# 指定しないとMacのCPUアーキテクチャ(arm64)向けにビルドされてしまい、
# x86_64のUbuntu実機で動かなくなる):
#
#   docker build --platform linux/amd64 -f doc/Dockerfile.radonpy -t radonpy:latest .
#
# 動作確認:
#
#   docker run --rm --platform linux/amd64 radonpy:latest \
#     conda run -n radonpy python -c "import rdkit, radonpy; print('ok')"
#
# RadonPyのソースコード(git clone、example/サンプル込み)は /opt/RadonPy に
# 置いてある。importされる本体は、リポジトリに同梱されているビルド済み
# wheel(/opt/RadonPy/dist/*.whl)をインストールしたもの。
# (PyPI版radonpy-pypiはgit最新版と内容が異なり、AutoMD_scripts等の
# サンプルが要求するモジュール(radonpy.ff.dreiding等)が無いことを
# 実機で確認した。また `pip install -e .` はRadonPy自体のsetup.py/
# pyproject.tomlの記述矛盾(python_requiresの二重定義)により新しめの
# setuptoolsでビルドが失敗することも確認したため、同梱wheelを直接
# installする方式にした。/opt/RadonPy を編集してもimportには反映
# されない点に注意)
#
# 保存してオフライン機へ転送する場合(レジストリを使わない方法):
#
#   docker save radonpy:latest | gzip > radonpy-image.tar.gz
#   # USB等で転送後、オフライン機側で:
#   docker load < radonpy-image.tar.gz
#
# GitHub Container Registry (ghcr.io) にpushして使う場合:
#
#   echo <GitHubのPAT(write:packages)> | docker login ghcr.io -u <ユーザー名> --password-stdin
#   docker tag radonpy:latest ghcr.io/<ユーザー名>/radonpy:latest
#   docker push ghcr.io/<ユーザー名>/radonpy:latest
#   # push後、GitHubのPackages画面でVisibilityをPublicにするとストレージ/帯域無料
#
# 実機にDockerを入れたくない場合は、Docker daemon不要の`crane`コマンドで
# イメージの中身(/opt/miniforge3以下)だけをtarとして取り出し、実機へは
# ただのファイルとして配置する方法もある。詳細はdoc/radonpy-files.mdの
# 5.4.1節を参照。

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates bzip2 git \
    && rm -rf /var/lib/apt/lists/*

# Miniforge導入(conda-forge専用ディストリビューション。Anaconda社の
# defaultsチャンネルを一切経由しない)
RUN curl -fsSL -o /tmp/miniforge.sh \
    https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
    && bash /tmp/miniforge.sh -b -p /opt/miniforge3 \
    && rm /tmp/miniforge.sh

ENV PATH=/opt/miniforge3/bin:$PATH

RUN conda config --set always_yes true \
    && conda config --set channel_priority strict

RUN conda create -n radonpy python=3.11 --override-channels -c conda-forge -y

# RadonPyが要求する外部ツール・依存パッケージ一式(doc/radonpy-files.md参照)。
#
# libint / libxc-c はバージョンを明示的に固定している。理由:
# psi4は`libint2.so.2`というSONAME(バージョン付き共有ライブラリ名)を
# 前提にリンクされているが、conda-forgeの新しいlibintビルド(2.13.1)は
# `libint2.so`(バージョン無し)にSONAMEが変わっており、psi4の依存指定
# (libint >=2.9.0,<3.0a0)の範囲内であるにもかかわらず
# `ImportError: libint2.so.2: cannot open shared object file`で
# 壊れることを実機で確認した。同様にlibxc-c 7.1.2ではpsi4が使う
# 一部の交換相関汎関数(XC_GGA_XC_TH_FL等)が見つからず
# `RuntimeError: Could not find required LibXC functional`になることも
# 確認した。いずれも古いビルドに固定することで解消する。
RUN conda install -n radonpy --override-channels -c conda-forge -c psi4 \
    rdkit psi4 dftd3-python resp mdtraj psutil scipy pandas matplotlib pip lammps \
    "libint=2.9.0" "libxc-c=7.0.0=cpu_h75f4f88_6" -y \
    && conda clean -afy

# RadonPy本体。リポジトリに同梱されているビルド済みwheel(dist/*.whl)を
# 直接installする(理由は上記コメント参照)。--no-deps は、既に
# conda-forge側で入れたnumpy/scipy等をpip側で二重に入れ直して
# 壊さないため。
RUN git clone --depth 1 https://github.com/RadonPy/RadonPy.git /opt/RadonPy \
    && conda run -n radonpy pip install --no-cache-dir --no-deps /opt/RadonPy/dist/*.whl

# コンテナに入った時点でradonpy環境がデフォルトになるようにしておく。
# LD_LIBRARY_PATHも明示しておかないと、`conda run`/`conda activate`を
# 経由しない素のシェル(docker run ... /bin/bash等)からpsi4を
# importした際に `libint2.so.2: cannot open shared object file` の
# ようなエラーになることを実機で確認したため。
ENV PATH=/opt/miniforge3/envs/radonpy/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/miniforge3/envs/radonpy/lib

# LAMMPSはOpenMPI(mpirun)経由で実行されるが、このコンテナはrootで動作
# するため、デフォルトのままだと
# 「prterun has detected an attempt to run as root」で拒否されて
# 動かない(実機で確認)。RadonPyのAutoMD_scriptsは内部でmpirunを
# 起動するため、恒久的に許可しておく。
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# ビルド時点で最低限の動作確認をしておく(壊れていればここでビルド自体が失敗する)。
# `conda run`経由ではなく、実際にユーザーが使う素のシェル状態
# (上のENVだけが効いた状態)でimportできるかを検証する。
# `import psi4`だけでは`libxc`側の関数欠落(RuntimeError: Could not
# find required LibXC functional)を検出できないため、RadonPyの
# デフォルトQM手法(wb97m-d3bj)で実際にエネルギー計算まで行い、
# libint/libxcの組み合わせが正しく動くことまで確認する。
RUN python -c "import rdkit, psi4, radonpy; print('rdkit', rdkit.__version__)" \
    && psi4 --version \
    && lmp -h > /dev/null \
    && python -c "\
import psi4; \
psi4.set_memory('500 MB'); \
psi4.geometry('H 0 0 0\nH 0 0 0.74'); \
psi4.set_options({'basis': 'sto-3g'}); \
e = psi4.energy('wb97m-d3bj'); \
print('psi4 wb97m-d3bj energy OK', e)"

WORKDIR /work
CMD ["/bin/bash"]
