# pandas, numpy, scikit-learn, pytorch(GPU/CUDA版), matplotlib, tqdm, rdkit,
# jupyter を使うための実行環境イメージ。doc/Dockerfile.radonpy-gpu と
# 同じ考え方(ビルド自体はネット接続のある環境で普通に行い、
# `docker save`/`docker load` でオフライン機へまるごと転送する)。
#
# doc/ml-conda-windows-download.ps1 + doc/ml-conda-offline-install.sh の
# ような「conda パッケージだけを集めて実機のconda環境に組み込む」方式に
# 比べて、Dockerイメージごと転送するこちらの方法は
#   - glibcバージョン合わせや`--offline`時のrepodataの扱いを一切気にしなくてよい
#     (docker save/loadはイメージのファイルシステムをそのまま転送するため)
#   - 実機にconda/Miniforgeを入れる必要がない(Dockerさえあればよい)
# という点でシンプル。反面、実機にDockerとNVIDIA Container Toolkitの
# セットアップが必要になる。
#
# 前提(ホスト側 = 実際にコンテナを動かすマシン):
#   - NVIDIA製GPU
#   - NVIDIAドライバ(Windows+WSL2の場合はWindows側にインストールする)
#   - NVIDIA Container Toolkit(doc/Dockerfile.radonpy-gpu 冒頭のコメント
#     に導入コマンドあり)
#
# ビルド(ビルド自体にGPUは不要。ネットに繋がった環境で実行する):
#
#   docker build -f doc/Dockerfile.ml-gpu -t ml-gpu:latest .
#
# 実行(必ず --gpus all を付けること):
#
#   docker run --rm -it --gpus all -p 8888:8888 ml-gpu:latest
#
# Jupyter Labをコンテナ内で起動する場合:
#
#   docker run --rm -it --gpus all -p 8888:8888 ml-gpu:latest \
#     conda run -n ml --no-capture-output jupyter lab --ip=0.0.0.0 --allow-root
#
# オフライン機へ転送する場合(レジストリを使わない方法):
#
#   docker save ml-gpu:latest | gzip > ml-gpu-image.tar.gz
#   # USB等で転送後、オフライン機側で:
#   docker load < ml-gpu-image.tar.gz
#
# CPU版が欲しい場合は、下のconda installから
# "pytorch=*=*cuda*" "cuda-version=13.3" の指定を外し、ENV CONDA_OVERRIDE_CUDA
# の行を削除すればよい(`docker run`時の --gpus all も不要になる)。

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates bzip2 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/miniforge.sh \
    https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
    && bash /tmp/miniforge.sh -b -p /opt/miniforge3 \
    && rm /tmp/miniforge.sh

ENV PATH=/opt/miniforge3/bin:$PATH

RUN conda config --set always_yes true \
    && conda config --set channel_priority strict

RUN conda create -n ml python=3.11 --override-channels -c conda-forge -y

# ビルド環境(docker build実行中)には通常GPUが無いため、pytorchのCUDA版を
# 解決させるにはCONDA_OVERRIDE_CUDAで「CUDAが使える」と明示してやる必要が
# ある(doc/ml-conda-windows-download.ps1と同じ理由)。
ENV CONDA_OVERRIDE_CUDA=13.3

RUN conda install -n ml --override-channels -c conda-forge \
    pandas numpy scikit-learn matplotlib tqdm rdkit jupyter \
    "pytorch=*=*cuda*" "cuda-version=13.3" -y \
    && conda clean -afy

ENV PATH=/opt/miniforge3/envs/ml/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/miniforge3/envs/ml/lib

# ビルド環境には通常GPUが無いため、torch.cuda.is_available()の確認は
# ここでは行わない(実機で --gpus all を付けて確認すること)。importの
# 存在確認のみ行う。
RUN python -c "import pandas, numpy, sklearn, matplotlib, tqdm, rdkit, torch; print('rdkit', rdkit.__version__, 'torch', torch.__version__)" \
    && jupyter --version

WORKDIR /work
CMD ["/bin/bash"]
