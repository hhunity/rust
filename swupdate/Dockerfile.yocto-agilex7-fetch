# Agilex 7向けgsrd-socfpgaビルドに必要なソース一式(downloads/, sstate_cache/)を
# 事前フェッチして焼き込んだイメージ。doc/Dockerfile.ml-gpuと同じ「Dockerイメージごと
# 転送する」方式。WSL側がネットワーク制限で塞がれていて、かつWindows Docker Desktopは
# ネットに繋がっている、という環境向け。
#
# 使い方(Windows Docker Desktop側。ネット接続あり):
#   docker build -f swupdate/Dockerfile.yocto-agilex7-fetch \
#     --build-arg POKY_VERSION=scarthgap \
#     --build-arg BUILD_SCRIPT=agilex7_dk_si_agf014ea-gsrd-build.sh \
#     -t yocto-agilex7-fetch:latest swupdate/
#   docker save yocto-agilex7-fetch:latest | gzip > yocto-agilex7-fetch.tar.gz
#
# (USB等でオフライン機へ転送後、オフラインのDocker環境側で)
#   docker load < yocto-agilex7-fetch.tar.gz
#   docker run --rm -it yocto-agilex7-fetch:latest bash
#
# コンテナ内で(ネット不要。downloads/はイメージに焼き込み済み):
#   cd /workspace/gsrd-socfpga
#   source ./agilex7_dk_si_agf014ea-gsrd-build.sh
#   build_setup
#   bitbake_image
#
# NOTE: このDockerfileはgsrd-socfpga/build.shの実際の中身を読んで作成したもので、
# 構造面での確認はできているが、実際に docker build を最後まで走らせての動作確認は
# まだ行っていない(ビルド対象のソース総量が数GB〜十数GBになり、時間もかかるため)。
# 初回はWindows側で `docker build` を実行し、エラーが出ないか確認すること。

FROM ubuntu:24.04

ARG POKY_VERSION=scarthgap
ARG BUILD_SCRIPT=agilex7_dk_si_agf014ea-gsrd-build.sh
ENV DEBIAN_FRONTEND=noninteractive \
    POKY_VERSION=${POKY_VERSION} \
    BUILD_SCRIPT=${BUILD_SCRIPT}

# doc/yocto-urls.txt と同じパッケージ一式(ビルド時はネットがあるのでaptで直接取得)
RUN apt-get update && apt-get install -y --no-install-recommends \
      gawk wget git diffstat unzip texinfo build-essential chrpath socat cpio \
      python3 python3-pip python3-pexpect xz-utils debianutils iputils-ping \
      python3-git python3-jinja2 python3-subunit zstd liblz4-tool lz4 file \
      locales libacl1 ca-certificates \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8

COPY yocto-agilex7-fetch.sh /usr/local/bin/yocto-agilex7-fetch.sh
RUN chmod +x /usr/local/bin/yocto-agilex7-fetch.sh \
    && /usr/local/bin/yocto-agilex7-fetch.sh

WORKDIR /workspace/gsrd-socfpga
CMD ["/bin/bash"]
