<UserControl x:Class="DockSample.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DockSample.ViewModels"
             xmlns:views="clr-namespace:DockSample.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="400" d:DesignHeight="300">
    <!-- DataContext は DataTemplate から SettingsViewModel が自動で入る -->
    <!--
      HorizontalContentAlignment は TabControl 側に指定する
      （標準の TabItem はヘッダー位置を親の TabControl から取るため、TabItem に指定しても効かない）
    -->
    <!-- Ctrl+Z / Ctrl+Y：設定ペインにフォーカスがあるとき有効。
         文字を入力中の入力欄では、入力欄自身の Ctrl+Z（入力中の文字を戻す）が優先される -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl"       Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl"       Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- 下：今のファイル・未保存の表示と、ファイル操作のボタン -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="8,6">
            <StackPanel>
                <TextBlock Text="{Binding FileName, StringFormat='設定ファイル: {0}'}"
                           ToolTip="{Binding FilePath}"
                           Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="● 保存していない変更があります"
                           Style="{StaticResource Text.Caption}"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisible}}" />

                <!-- ボタンは右寄せ。ペインが狭いときは折り返す -->
                <WrapPanel HorizontalAlignment="Right" Margin="0,6,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Default}">
                            <Setter Property="Margin" Value="6,0,0,4" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Content="↶ 元に戻す"         Command="{Binding UndoCommand}" ToolTip="1つ前の状態に戻す (Ctrl+Z)" />
                    <Button Content="↷ やり直し"         Command="{Binding RedoCommand}" ToolTip="元に戻した操作をやり直す (Ctrl+Y)" />
                    <Button Content="開く..."             Command="{Binding OpenCommand}" />
                    <Button Content="名前を付けて保存..." Command="{Binding SaveAsCommand}" />
                    <Button Content="保存した状態に戻す"  Command="{Binding RevertCommand}" />
                    <Button Content="保存"                Command="{Binding SaveCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl ItemsSource="{Binding Pages}"
                    SelectedItem="{Binding SelectedPage}"
                    TabStripPlacement="Left"
                    HorizontalContentAlignment="Left"
                    BorderThickness="1,0,0,0">

            <!-- タブの幅・余白 -->
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <!-- 自動で折り返したいなら Width を固定する。\n で改行するだけなら MinWidth でよい -->
                    <Setter Property="Width" Value="120" />
                    <Setter Property="Padding" Value="10,6" />
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- ヘッダー：左寄せ・改行対応・エラーの印 -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip="{Binding ErrorSummary}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="HeaderText"
                                   Text="{Binding Header}"
                                   Style="{StaticResource Text.Body}"
                                   TextWrapping="Wrap" TextAlignment="Left"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />

                        <views:ErrorBadge x:Name="ErrorMark" Grid.Column="1"
                                          Margin="6,0,0,0" Visibility="Collapsed" />
                    </Grid>

                    <!-- HasErrors が true のときだけ、印を表示して文字も赤くする -->
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                            <Setter TargetName="ErrorMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{StaticResource Brush.Error}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- タブの中身は App.xaml の DataTemplate（ページの ViewModel → View）で決まる -->
        </TabControl>
    </DockPanel>
</UserControl>
