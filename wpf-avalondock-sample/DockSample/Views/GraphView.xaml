<UserControl x:Class="DockSample.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DockSample.ViewModels"
             xmlns:controls="clr-namespace:DockSample.Controls"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GraphViewModel}"
             d:DesignWidth="700" d:DesignHeight="500">
    <!-- DataContext は DataTemplate から GraphViewModel が自動で入る。グラフはコードビハインドで描く -->

    <UserControl.Resources>
        <!-- セグメントの表の数値のセルを編集中の TextBox：フォーカスがあるときマウスホイールで増減（Controls/NumericWheel） -->
        <!-- BasedOn：DataGrid が編集中のセルに使う既定の見た目（枠なし・余白なし）を引き継ぐ -->
        <Style x:Key="SegmentNumberEditor" TargetType="TextBox"
               BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
            <Setter Property="controls:NumericWheel.Increment" Value="0.1" />
            <Setter Property="controls:NumericWheel.LargeIncrement" Value="1" />
        </Style>
        <!-- 0 未満にならない数値（スルーレート・時間） -->
        <Style x:Key="SegmentPositiveNumberEditor" TargetType="TextBox" BasedOn="{StaticResource SegmentNumberEditor}">
            <Setter Property="controls:NumericWheel.Minimum" Value="0" />
        </Style>

        <!--
          下の編集欄：Editor の型ごとに表示を切り替える（ContentControl が型を見て選ぶ）。
          機種を増やして編集欄も作ったら、ここに DataTemplate を足す。
        -->

        <!-- パルスを持つ機種：左にパルスの一覧、右に選んだパルスのセグメントの表 -->
        <DataTemplate DataType="{x:Type vm:WaveformEditorViewModel}">
            <DockPanel>
            <!-- 上：時間 0 での電圧（restingVoltage）。Enter・フォーカスが外れたとき・ホイールで反映され、グラフも描き直される -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,0">
                <TextBlock Text="初期電圧 (V)" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Width="90" Style="{StaticResource Input.TextBox}"
                         Text="{Binding RestingVoltage, StringFormat=F2}"
                         controls:NumericWheel.Increment="0.1" controls:NumericWheel.LargeIncrement="1"
                         ToolTip="時間 0 での電圧。ホイールで 1、Ctrl＋ホイールで 0.1 ずつ増減" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- 左：パルスの一覧 -->
                <DockPanel Grid.Column="0" Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <!-- DockPanel の右寄せは先に書いたものほど右端：右から「＋ 最後」「＋ 先頭」 -->
                        <Button DockPanel.Dock="Right" Content="＋ 最後" Padding="8,1" Margin="4,0,0,0"
                                ToolTip="最後にパルスを追加" Command="{Binding AddPulseCommand}" />
                        <Button DockPanel.Dock="Right" Content="＋ 先頭" Padding="8,1"
                                ToolTip="先頭にパルスを追加" Command="{Binding AddPulseFirstCommand}" />
                        <TextBlock Text="パルス" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Pulses}" SelectedItem="{Binding SelectedPulse}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- 行の DataContext はパルスの行なので、一覧（ListBox）の ViewModel のコマンドを辿って呼ぶ -->
                                    <Button DockPanel.Dock="Right" Content="削除" Padding="6,0" Margin="4,0,0,0"
                                            Command="{Binding DataContext.RemovePulseCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <Button DockPanel.Dock="Right" Content="コピー" Padding="6,0" Margin="4,0,0,0"
                                            ToolTip="すぐ下に同じ中身のパルスを入れる"
                                            Command="{Binding DataContext.CopyPulseCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="#EEEEEE" ResizeBehavior="PreviousAndNext" />

                <!-- 右：選んだパルスの名前とセグメント -->
                <DockPanel Grid.Column="2" Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <!-- 最後に追加（セグメントが1つもないときもこれで足せる）。途中に入れるのは各行の「↑追加」「↓追加」 -->
                        <Button DockPanel.Dock="Right" Content="＋ 最後に追加" Padding="8,1" Margin="8,0,0,0"
                                Command="{Binding AddSegmentCommand}" />
                        <!-- パルスの名前は並び順で自動で付く（Pulse0, Pulse1, ...）ので、表示だけ -->
                        <TextBlock Text="{Binding SelectedPulse.Name}" Style="{StaticResource Text.Label}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 行をクリック・キーで移動したら、そのセグメントをグラフで目立たせる
                         （SelectedItem のバインドに加えて、セルを移ったとき（CurrentCellChanged）も選び直す） -->
                    <DataGrid ItemsSource="{Binding SelectedPulse.Segments}"
                              SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                              CurrentCellChanged="SegmentGrid_CurrentCellChanged"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Number, Mode=OneWay}" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="2*" />
                            <!-- 数値の列はセルの編集を終えたとき（Enter・別のセルへ移動）に反映される -->
                            <!-- 数値は小数2桁まで表示（足りなければ 0 で埋める：5 → 5.00）。StringFormat は見せ方だけで、値そのものは丸めない -->
                            <!-- 編集中（セルの中で入力中）はマウスホイールで増減できる：ホイールで 1、Ctrl＋ホイールで 0.1 ずつ（NumericWheel） -->
                            <DataGridTextColumn Header="目標電圧 (V)" Binding="{Binding TargetVoltage, StringFormat=F2}" Width="*"
                                                EditingElementStyle="{StaticResource SegmentNumberEditor}" />
                            <DataGridTextColumn Header="スルーレート (V/µs)" Binding="{Binding SlewRate, StringFormat=F2}" Width="*"
                                                EditingElementStyle="{StaticResource SegmentPositiveNumberEditor}" />
                            <!-- ファイルは ns、ここは µs で見せる（換算は SegmentRowViewModel.DurationUs） -->
                            <DataGridTextColumn Header="時間 (µs)" Binding="{Binding DurationUs, StringFormat=F2}" Width="*"
                                                EditingElementStyle="{StaticResource SegmentPositiveNumberEditor}" />
                            <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <!-- 行の DataContext はセグメントの行なので、表（DataGrid）の ViewModel のコマンドを辿って呼ぶ -->
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="↑追加" Padding="6,1" Margin="2" ToolTip="この行の前に追加"
                                                    Command="{Binding DataContext.InsertSegmentBeforeCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="↓追加" Padding="6,1" Margin="2" ToolTip="この行の後ろに追加"
                                                    Command="{Binding DataContext.InsertSegmentAfterCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="削除" Padding="8,1" Margin="2"
                                                    Command="{Binding DataContext.RemoveSegmentCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- 電圧源 -->
        <DataTemplate DataType="{x:Type vm:DcSourceEditorViewModel}">
            <Grid Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="電圧 (V)" Style="{StaticResource Text.FieldLabel}" />
                <controls:NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Voltage}"
                                        Minimum="-1000" Maximum="1000" Increment="0.1" DecimalPlaces="2"
                                        Width="120" Margin="0,0,0,6" Style="{StaticResource Input.Numeric}" />

                <TextBlock Grid.Row="1" Text="電流制限 (A)" Style="{StaticResource Text.FieldLabel}" />
                <controls:NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding LimitCurrent}"
                                        Minimum="0" Maximum="100" Increment="0.01" DecimalPlaces="2"
                                        Width="120" Margin="0,0,0,6" Style="{StaticResource Input.Numeric}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- 上：デバイス / uuid の選択・追加・削除・名前 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
            <WrapPanel>
                <TextBlock Text="デバイス" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <!-- Display は名前を変えるとすぐ変わる（ToString だと表示が更新されない） -->
                <ComboBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                          DisplayMemberPath="Display" MinWidth="250" />

                <!-- 追加：機種を選ぶと、その機種の波形を1つ足す -->
                <controls:DropDownButton Header="追加" Margin="8,0,0,0"
                                         ItemsSource="{Binding DeviceNames}"
                                         Command="{Binding AddWaveformCommand}"
                                         IsSearchEnabled="False"
                                         Style="{StaticResource Input.DropDown}" />
                <Button Content="削除" Padding="8,1" Margin="4,0,0,0" Command="{Binding RemoveWaveformCommand}" />
                <Button Content="エクスポート..." Padding="8,1" Margin="4,0,0,0" Command="{Binding ExportWaveformCommand}"
                        ToolTip="選んでいる波形を、別の JSON ファイルに書き出す" />
                <Button Content="インポート..." Padding="8,1" Margin="4,0,0,0" Command="{Binding ImportWaveformCommand}"
                        ToolTip="JSON ファイルの波形を追加する（waveforms.json も読める）" />

                <TextBlock Text="名前" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="160"
                         Style="{StaticResource Input.TextBox}" />
            </WrapPanel>
        </Border>

        <!-- 波形がないとき -->
        <TextBlock DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap"
                   Text="波形がありません。「追加」で機種を選ぶか、設定フォルダに waveforms.json を置いて、設定ペインの「開く...」で読み込んでください。">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 選んだものに、グラフにできる機種の変換クラスがないとき -->
        <TextBlock DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap"
                   Text="この機種はグラフにできません（Graphs/SeriesConverters.cs に変換クラスがありません）。"
                   Style="{StaticResource Text.Caption}"
                   Visibility="{Binding HasNoSeries, Converter={StaticResource BoolToVisible}}" />

        <!-- 上：グラフ / 下：編集欄（間のつまみで高さを変えられる） -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="100" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="240" MinHeight="80" />
            </Grid.RowDefinitions>

            <ScottPlot:WpfPlot x:Name="Chart" Grid.Row="0" />

            <!-- グラフの右上に重ねる：拡大・縮小・全体表示（見た目だけの操作なので、処理はコードビハインド） -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,6,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="＋" Width="28" Click="ZoomIn_Click" ToolTip="拡大" />
                <Button Content="－" Width="28" Margin="2,0,0,0" Click="ZoomOut_Click" ToolTip="縮小" />
                <Button Content="全体" Padding="6,0" Margin="2,0,0,0" Click="ZoomFit_Click" ToolTip="全体を表示" />
            </StackPanel>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="#EEEEEE" ResizeBehavior="PreviousAndNext" />

            <!-- Editor の型（機種）に合わせて、上の DataTemplate が選ばれる。編集欄のない機種では空 -->
            <ContentControl Grid.Row="2" Content="{Binding Editor}" Focusable="False" />
        </Grid>
    </DockPanel>
</UserControl>
