<UserControl x:Class="DockSample.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DockSample.ViewModels"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GraphViewModel}"
             d:DesignWidth="600" d:DesignHeight="300">
    <!-- DataContext は DataTemplate から GraphViewModel が自動で入る。グラフはコードビハインドで描く -->
    <DockPanel>
        <!-- 上：パルスの選択 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="パルス" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Pulses}" SelectedItem="{Binding SelectedPulse}" MinWidth="250" />
            </StackPanel>
        </Border>

        <!-- 波形がないとき -->
        <TextBlock DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap"
                   Text="波形がありません。設定フォルダに waveforms.json を置いて、設定ペインの「開く...」で読み込んでください。">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Pulses.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScottPlot:WpfPlot x:Name="Chart" />
    </DockPanel>
</UserControl>
