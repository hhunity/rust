<UserControl x:Class="DockSample.Views.ErrorBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="14" Height="14" VerticalAlignment="Center">
    <!-- エラーの印（赤丸に「!」）。タブと上部ボタンで共通に使う -->
    <Grid>
        <Ellipse Fill="{StaticResource Brush.Error}" />
        <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="10"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
