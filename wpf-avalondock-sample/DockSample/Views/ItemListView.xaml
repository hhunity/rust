<UserControl x:Class="DockSample.Views.ItemListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DockSample.ViewModels"
             xmlns:controls="clr-namespace:DockSample.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ItemListViewModel}"
             d:DesignWidth="600" d:DesignHeight="300">
    <!-- DataContext は DataTemplate から ItemListViewModel が自動で入る -->
    <DockPanel>
        <!-- 上：追加ボタン（種類を選ぶと1行追加）と件数 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
            <DockPanel>
                <controls:DropDownButton Header="追加"
                                         ItemsSource="{Binding ItemTypes}"
                                         Command="{Binding AddCommand}"
                                         Style="{StaticResource Input.DropDown}">
                    <!-- 一覧の項目：名前と、右に小さく分類 -->
                    <controls:DropDownButton.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Category}"
                                           Style="{StaticResource Text.Caption}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                            </DockPanel>
                        </DataTemplate>
                    </controls:DropDownButton.ItemTemplate>
                </controls:DropDownButton>

                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- 表 -->
        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE"
                  BorderThickness="0"
                  FontFamily="{StaticResource Font.Base}"
                  FontSize="{DynamicResource FontSize.Body}">

            <!-- 無効にした行は文字を薄くする -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSub}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- 名前（ダブルクリック / F2 / そのまま入力 で編集。打つたびに「編集」の印に反映） -->
                <DataGridTextColumn Header="名前" Width="2*"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 種類（追加時に決まる。編集不可） -->
                <DataGridTextColumn Header="種類" Width="*" IsReadOnly="True"
                                    Binding="{Binding Type.Name}" />

                <!-- 備考 -->
                <DataGridTextColumn Header="備考" Width="3*"
                                    Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 有効：1回のクリックで切り替わるよう、チェックボックスを直接置く
                     （DataGridCheckBoxColumn は、セルを選ぶクリック＋切り替えるクリックの2回必要） -->
                <DataGridTemplateColumn Header="有効" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 編集：追加したときから変わっていれば ● -->
                <DataGridTemplateColumn Header="編集" Width="Auto" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="●" Foreground="#E67E22" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" ToolTip="追加したあとに編集されています"
                                       Visibility="{Binding IsModified, Converter={StaticResource BoolToVisible}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 削除：行の DataContext は行の ViewModel なので、表（DataGrid）の ViewModel のコマンドを辿って呼ぶ -->
                <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="削除" Padding="8,1" Margin="2"
                                    Command="{Binding DataContext.RemoveCommand,
                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
