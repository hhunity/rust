<UserControl x:Class="DockSample.Views.AppearancePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DockSample.ViewModels"
             xmlns:controls="clr-namespace:DockSample.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppearancePageViewModel}"
             d:DesignWidth="300" d:DesignHeight="200">

    <!-- 文字・入力欄のスタイルは Styles/Typography.xaml, Styles/Controls.xaml -->
    <StackPanel Margin="12">
        <TextBlock Text="外観" Style="{StaticResource Text.Title}" />

        <TextBlock Text="文字サイズ" Style="{StaticResource Text.Label}" />
        <!-- 数値入力の部品：上下ボタン・↑↓キー・ホイールで 0.5 ずつ。8～32 の外には出ない -->
        <controls:NumericUpDown Value="{Binding FontSize}"
                                Minimum="8" Maximum="32" Increment="0.5" DecimalPlaces="1"
                                Style="{StaticResource Input.Numeric}"
                                Width="90" Margin="0,0,0,22" />
        <TextBlock Text="8～32 で指定（0.5 刻み）。アプリ全体の文字サイズがすぐに変わります。"
                   Style="{StaticResource Text.Caption}" />

        <TextBlock Text="スタイル見本" Style="{StaticResource Text.Heading}" />
        <TextBlock Text="Text.Title"   Style="{StaticResource Text.Title}" Margin="0" />
        <TextBlock Text="Text.Heading" Style="{StaticResource Text.Heading}" Margin="0" />
        <TextBlock Text="Text.Body"    Style="{StaticResource Text.Body}" />
        <TextBlock Text="Text.Caption" Style="{StaticResource Text.Caption}" />
        <TextBlock Text="Text.Error"   Style="{StaticResource Text.Error}" />
        <TextBlock Text="Text.Code"    Style="{StaticResource Text.Code}" />
    </StackPanel>
</UserControl>
