<UserControl x:Class="DockSample.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DockSample.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DocumentViewModel}"
             d:DesignWidth="300" d:DesignHeight="200">
    <!-- DataContext は DataTemplate から DocumentViewModel が自動で入る（ここで設定しない） -->
    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource Input.Code}" />
</UserControl>
