<!--
  入力系コントロールの共通スタイル。Typography.xaml の部品（フォント・色・文字スタイル）を使う。
  StaticResource で確実に参照できるよう、このファイル自身でも Typography.xaml を読み込んでいる。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DockSample.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- エラー時の表示：赤枠＋下にメッセージ（INotifyDataErrorInfo の内容）。入力系の部品で共通 -->
    <ControlTemplate x:Key="Validation.WithMessage">
        <StackPanel>
            <Border BorderBrush="{StaticResource Brush.Error}" BorderThickness="1">
                <AdornedElementPlaceholder />
            </Border>
            <TextBlock Text="{Binding [0].ErrorContent}"
                       Style="{StaticResource Text.Error}" Margin="0,2,0,0" />
        </StackPanel>
    </ControlTemplate>

    <!-- 入力欄 -->
    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Padding"    Value="3,2" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.WithMessage}" />
    </Style>

    <!-- 数値入力（Controls/NumericUpDown） -->
    <Style x:Key="Input.Numeric" TargetType="{x:Type controls:NumericUpDown}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Body}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.WithMessage}" />
    </Style>

    <!-- 等幅のエディタ（ドキュメント用） -->
    <Style x:Key="Input.Code" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Body}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- true → Visible / false → Collapsed（WPF標準）。チェックONで項目を出す、などに使う。
         ※ Converters/BoolToVisibilityConverter（Hidden を返す）は AvalonDock のペイン専用 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    <Style x:Key="Input.CheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Body}" />
    </Style>

    <!-- ボタン。幅は Auto（文字＋左右の Padding）で、短い文字でも MinWidth までは確保する -->
    <Style x:Key="Button.Default" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Padding"    Value="12,4" />
        <Setter Property="MinWidth"   Value="72" />
    </Style>

    <!-- 一覧 -->
    <Style x:Key="List.Plain" TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Body}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="List.Code" TargetType="ListBox" BasedOn="{StaticResource List.Plain}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>
</ResourceDictionary>
