<Application x:Class="DockSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DockSample.ViewModels"
             xmlns:views="clr-namespace:DockSample.Views">
    <!-- StartupUri は削除（DIで MainWindow を生成するため） -->
    <Application.Resources>
        <!--
          ViewModel → View(UserControl) の対応表。
          フローティングウィンドウからも見つかるよう App レベルに置く。
        -->
        <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
            <views:DocumentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PropertiesViewModel}">
            <views:PropertiesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OutputViewModel}">
            <views:OutputView />
        </DataTemplate>
    </Application.Resources>
</Application>
