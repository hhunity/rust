<Application x:Class="DockSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DockSample.ViewModels"
             xmlns:views="clr-namespace:DockSample.Views">
    <!-- StartupUri は削除（DIで MainWindow を生成するため） -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- 共通スタイル（Styles/ フォルダ）。文字 → コントロールの順で読み込む -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              ViewModel → View(UserControl) の対応表。
              フローティングウィンドウからも見つかるよう App レベルに置く。
            -->
            <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                <views:DocumentView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
                <views:ExplorerView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PropertiesViewModel}">
                <views:PropertiesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:OutputViewModel}">
                <views:OutputView />
            </DataTemplate>

            <!-- 設定ペインと、その左タブの各ページ -->
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:GeneralPageViewModel}">
                <views:GeneralPageView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AppearancePageViewModel}">
                <views:AppearancePageView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
